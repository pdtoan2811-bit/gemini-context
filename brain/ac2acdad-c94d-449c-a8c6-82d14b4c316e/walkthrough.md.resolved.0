```diff:useAdsSandboxStore.tsx
===
"use client";

import React, {
  createContext,
  useContext,
  useReducer,
  useCallback,
  useMemo,
  type ReactNode,
} from "react";
import type {
  AdsSandboxState,
  AdsSandboxAction,
  AdsEvent,
} from "@/types/ads-sandbox-types";
import {
  DEFAULT_ADS_STATE,
  makeEventId,
  makeTimestamp,
} from "@/data/mock-ads-sandbox-data";
import type { AdsAccountItem } from "@/types/ads";

/* ════════════════════════════════════════════════════════════
   REDUCER
   ════════════════════════════════════════════════════════════ */

function reducer(
  state: AdsSandboxState,
  action: AdsSandboxAction,
): AdsSandboxState {
  switch (action.type) {
    case "RESET":
      return { ...DEFAULT_ADS_STATE, events: [...DEFAULT_ADS_STATE.events] };

    case "LOAD_SCENARIO":
      return { ...state, activeScenario: action.scenario };

    case "SET_SYNCING":
      return {
        ...state,
        isSyncing: action.isSyncing,
        syncStep: action.syncStep ?? null,
      };

    case "ADD_EVENT":
      return { ...state, events: [action.event, ...state.events] }; // prepend new events

    case "CHANGE_ACCOUNT_STATUS": {
      const { accountId, status } = action;
      const ts = makeTimestamp();

      const updatedAccounts = state.accounts.map((acc) =>
        acc.id === accountId
          ? {
              ...acc,
              ads_status: status,
              status_ads: status,
              updated_at: ts,
            }
          : acc,
      );

      return {
        ...state,
        accounts: updatedAccounts,
        events: [
          {
            id: makeEventId(),
            type: "status_changed",
            timestamp: ts,
            message: `Tài khoản đổi trạng thái thành: ${status}`,
            accountId,
          },
          ...state.events,
        ],
      };
    }

    case "DEPOSIT_BUDGET": {
      const { accountId, amount } = action;
      const ts = makeTimestamp();

      const updatedAccounts = state.accounts.map((acc) => {
        if (acc.id === accountId) {
          const newBudgetPaid = (acc.budget_paid ?? 0) + amount;
          const newBudgetRemaining = (acc.budget_remaining ?? 0) + amount;
          return {
            ...acc,
            budget_paid: newBudgetPaid,
            budget_remaining: newBudgetRemaining,
            ads_status: "active",
            status_ads: "active",
            updated_at: ts,
          };
        }
        return acc;
      });

      return {
        ...state,
        accounts: updatedAccounts,
        events: [
          {
            id: makeEventId(),
            type: "deposit_success",
            timestamp: ts,
            message: `Nạp thành công $${amount.toLocaleString()} vào tài khoản`,
            accountId,
          },
          ...state.events,
        ],
      };
    }

    case "EXHAUST_BUDGET": {
      const { accountId } = action;
      const ts = makeTimestamp();

      const updatedAccounts = state.accounts.map((acc) => {
        if (acc.id === accountId) {
          const used = acc.budget_paid ?? 0;
          return {
            ...acc,
            budget_used: used,
            budget_remaining: 0,
            ads_status: "inactive",
            status_ads: "inactive",
            updated_at: ts,
          };
        }
        return acc;
      });

      return {
        ...state,
        accounts: updatedAccounts,
        events: [
          {
            id: makeEventId(),
            type: "budget_exhausted",
            timestamp: ts,
            message: `Hết ngân sách. Tài khoản bị tạm dừng.`,
            accountId,
          },
          ...state.events,
        ],
      };
    }

    case "LINK_CAMPAIGN": {
      const { accountId, campaign } = action;
      const ts = makeTimestamp();

      const updatedAccounts = state.accounts.map((acc) => {
        if (acc.id === accountId) {
          return {
            ...acc,
            campaign: [...(Array.isArray(acc.campaign) ? acc.campaign : []), campaign],
            campaigns: [...(Array.isArray(acc.campaigns) ? acc.campaigns : []), campaign],
            updated_at: ts,
          };
        }
        return acc;
      });

      return {
        ...state,
        accounts: updatedAccounts,
        events: [
          {
            id: makeEventId(),
            type: "campaign_linked",
            timestamp: ts,
            message: `Chiến dịch "${campaign.name}" được kết nối với tài khoản`,
            accountId,
            campaignId: campaign.id,
          },
          ...state.events,
        ],
      };
    }

    case "EDIT_ACCOUNT": {
      const { accountId, updates } = action;
      const ts = makeTimestamp();

      const updatedAccounts = state.accounts.map((acc) =>
        acc.id === accountId
          ? {
              ...acc,
              ...updates,
              updated_at: ts,
            }
          : acc,
      );

      return {
        ...state,
        accounts: updatedAccounts,
        events: [
          {
            id: makeEventId(),
            type: "info",
            timestamp: ts,
            message: `Cập nhật thông tin tài khoản`,
            accountId,
          },
          ...state.events,
        ],
      };
    }

    default:
      return state;
  }
}

/* ════════════════════════════════════════════════════════════
   CONTEXT
   ════════════════════════════════════════════════════════════ */

interface AdsSandboxContextValue {
  state: AdsSandboxState;
  dispatch: React.Dispatch<AdsSandboxAction>;
  getAccount: (id: string) => AdsAccountItem | undefined;
  getEventsForAccount: (accountId: string) => AdsEvent[];
  activeAccounts: AdsAccountItem[];
  suspendedAccounts: AdsAccountItem[];
}

const AdsSandboxContext = createContext<AdsSandboxContextValue | null>(null);

export function AdsSandboxProvider({ children }: { children: ReactNode }) {
  const [state, dispatch] = useReducer(reducer, DEFAULT_ADS_STATE);

  const getAccount = useCallback(
    (id: string) => state.accounts.find((a) => a.id === id),
    [state.accounts],
  );

  const getEventsForAccount = useCallback(
    (accountId: string) =>
      state.events.filter((e) => e.accountId === accountId),
    [state.events],
  );

  const activeAccounts = useMemo(
    () => state.accounts.filter((a) => a.ads_status === "active" || a.ads_status === "enabled"),
    [state.accounts],
  );

  const suspendedAccounts = useMemo(
    () => state.accounts.filter((a) => a.ads_status === "suspended"),
    [state.accounts],
  );

  const value = useMemo<AdsSandboxContextValue>(
    () => ({
      state,
      dispatch,
      getAccount,
      getEventsForAccount,
      activeAccounts,
      suspendedAccounts,
    }),
    [state, getAccount, getEventsForAccount, activeAccounts, suspendedAccounts],
  );

  return (
    <AdsSandboxContext.Provider value={value}>
      {children}
    </AdsSandboxContext.Provider>
  );
}

export function useAdsSandboxStore() {
  const ctx = useContext(AdsSandboxContext);
  if (!ctx) {
    throw new Error(
      "useAdsSandboxStore must be used within an AdsSandboxProvider",
    );
  }
  return ctx;
}
```
```diff:AdsListPanel.tsx
===
"use client";

import React, { useState, useMemo, useCallback } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { type ColumnDef } from "@tanstack/react-table";
import { useAdsSandboxStore } from "@/hooks/useAdsSandboxStore";
import type { AdsAccountItem } from "@/types/ads";
import { DataTable } from "@/components/shared/data-table";
import { Checkbox } from "@/components/ui/checkbox";
import { BadgeStatus } from "@/components/shared/badge-status";
import { Button } from "@/components/ui/button";
import { toast } from "sonner";
import { Activity, AlertTriangle, Eye, DollarSign, PauseCircle } from "lucide-react";
import { AdsDetailView } from "./AdsDetailView";
import { SyncAnimation } from "@/containers/project-sandbox/SyncAnimation";
import { formatNumber } from "@/lib/utils";

type ViewState =
  | { view: "list" }
  | { view: "detail"; accountId: string };

type TabKey = "all" | "active" | "suspended";

const STATUS_INFO: Record<string, { type: "completed" | "info" | "neutral" | "failed" | "warning"; label: string }> = {
  active: { type: "completed", label: "Đang chạy" },
  enabled: { type: "completed", label: "Đang chạy" },
  inactive: { type: "neutral", label: "Tạm dừng" },
  paused: { type: "warning", label: "Tạm dừng" },
  suspended: { type: "failed", label: "Tạm ngưng" },
  pending: { type: "info", label: "Chờ duyệt" },
};

function formatBudgetAmount(value: number) {
  return `$${formatNumber(value, {
    decimals: 2,
    thousandsSeparator: ",",
    decimalSeparator: ".",
  })}`;
}

/* ═══════════════════════════════════════════════
   ADS LIST VIEW (DataTable)
   ═══════════════════════════════════════════════ */

function AdsListView({
  onViewDetail,
}: {
  onViewDetail: (id: string) => void;
}) {
  const { state, dispatch, activeAccounts, suspendedAccounts } = useAdsSandboxStore();
  const [tab, setTab] = useState<TabKey>("all");
  const [selectedIds, setSelectedIds] = useState<string[]>([]);
  const [isSyncingScenario, setIsSyncingScenario] = useState(false);
  const [scenarioSyncStep, setScenarioSyncStep] = useState(0);

  const filteredAccounts = useMemo(() => {
    if (tab === "active") return activeAccounts;
    if (tab === "suspended") return suspendedAccounts;
    return state.accounts;
  }, [tab, activeAccounts, suspendedAccounts, state.accounts]);

  // ── Table Columns ──
  const columns = useMemo<ColumnDef<AdsAccountItem>[]>(() => [
    {
      id: "select",
      header: ({ table }) => {
        const ids = table.getRowModel().rows.map((r) => r.original.id);
        const all = ids.length > 0 && ids.every((id) => selectedIds.includes(id));
        return (
          <Checkbox
            checked={all}
            onCheckedChange={() => setSelectedIds(all ? [] : ids)}
            aria-label="Chọn tất cả"
          />
        );
      },
      cell: ({ row }) => {
        const id = row.original.id;
        return (
          <Checkbox
            checked={selectedIds.includes(id)}
            onCheckedChange={() =>
              setSelectedIds((prev) =>
                prev.includes(id) ? prev.filter((x) => x !== id) : [...prev, id],
              )
            }
            aria-label={`Chọn ${row.original.name_ads}`}
            onClick={(e) => e.stopPropagation()}
          />
        );
      },
      size: 44,
      enableSorting: false,
    },
    {
      id: "index",
      header: "STT",
      cell: ({ row }) => (
        <span className="text-xs text-muted-foreground">{row.index + 1}</span>
      ),
      size: 52,
      enableSorting: false,
    },
    {
      accessorKey: "ads_name",
      header: "Tên Tài khoản",
      cell: ({ row }) => (
        <span className="font-medium text-foreground">{row.original.ads_name || row.original.name_ads}</span>
      ),
      size: 180,
    },
    {
      accessorKey: "ads_id",
      header: "Ads ID",
      cell: ({ row }) => (
        <span className="font-mono text-xs">{row.original.ads_id}</span>
      ),
      size: 120,
    },
    {
      id: "status",
      header: "Trạng thái",
      cell: ({ row }) => {
        const statusRaw = row.original.ads_status || row.original.status_ads || "unknown";
        const info = STATUS_INFO[statusRaw] ?? { type: "neutral", label: statusRaw };
        return <BadgeStatus type={info.type}>{info.label}</BadgeStatus>;
      },
      size: 120,
    },
    {
      accessorKey: "budget_paid",
      header: "Ngân sách (Đã nạp)",
      cell: ({ row }) => (
        <span className="text-sm">
          {formatBudgetAmount(row.original.budget_paid ?? 0)}
        </span>
      ),
      size: 140,
    },
    {
      accessorKey: "budget_remaining",
      header: "Ngân sách (Còn lại)",
      cell: ({ row }) => (
        <span className="text-sm font-semibold text-primary">
          {formatBudgetAmount(row.original.budget_remaining ?? 0)}
        </span>
      ),
      size: 140,
    },
    {
      id: "actions",
      header: () => <span className="sr-only">Actions</span>,
      cell: ({ row }) => (
        <div className="flex items-center justify-end gap-1.5" onClick={(e) => e.stopPropagation()}>
          <Button
            size="sm"
            className="h-7 gap-1 px-2.5 text-xs"
            onClick={() => dispatch({ type: "DEPOSIT_BUDGET", accountId: row.original.id, amount: 5000 })}
          >
            <DollarSign className="size-3" />
            Nạp Tiền
          </Button>
          <Button
            variant="outline" size="sm"
            className="h-7 gap-1 px-2.5 text-xs text-destructive border-destructive/30 hover:bg-destructive/10"
            onClick={() => dispatch({ type: "CHANGE_ACCOUNT_STATUS", accountId: row.original.id, status: "suspended" })}
          >
            <PauseCircle className="size-3" />
            Tạm Ngưng
          </Button>
          <Button
            variant="outline" size="sm"
            className="h-7 gap-1 px-2.5 text-xs"
            onClick={() => onViewDetail(row.original.id)}
          >
            <Eye className="size-3" />
            Xem
          </Button>
        </div>
      ),
      size: 260,
      enableSorting: false,
    },
  ], [selectedIds, onViewDetail, dispatch]);

  // ── Scenario auto-run ──
  const runScenarioAction = useCallback(async () => {
    const scenario = state.activeScenario;
    if (!scenario) return;

    switch (scenario) {
      case "auto_suspend": {
        setIsSyncingScenario(true);
        for (let i = 0; i < 3; i++) {
          await new Promise((r) => setTimeout(r, 600));
          setScenarioSyncStep(i + 1);
        }
        dispatch({
          type: "CHANGE_ACCOUNT_STATUS",
          accountId: "acc-101",
          status: "suspended",
        });
        toast.error("Tài khoản bị tạm ngưng do chính sách!");
        setIsSyncingScenario(false);
        setScenarioSyncStep(0);
        break;
      }
      case "budget_exhausted": {
        dispatch({ type: "EXHAUST_BUDGET", accountId: "acc-101" });
        toast.warning("Tài khoản đã hết ngân sách. Đã tạm dừng chiến dịch.");
        break;
      }
      case "deposit_success": {
        setIsSyncingScenario(true);
        for (let i = 0; i < 2; i++) {
          await new Promise((r) => setTimeout(r, 600));
          setScenarioSyncStep(i + 1);
        }
        dispatch({ type: "DEPOSIT_BUDGET", accountId: "acc-102", amount: 10000 });
        toast.success("Nạp thành công $10,000. Trạng thái hoạt động.");
        setIsSyncingScenario(false);
        setScenarioSyncStep(0);
        break;
      }
      case "error_api_rate_limit":
        toast.error("Google Ads API rate limit!", { duration: 5000 });
        break;
      default: break;
    }
  }, [state.activeScenario, dispatch]);

  const prevScenarioRef = React.useRef<string | null>(null);
  React.useEffect(() => {
    if (state.activeScenario && state.activeScenario !== prevScenarioRef.current) {
      prevScenarioRef.current = state.activeScenario;
      const t = setTimeout(runScenarioAction, 400);
      return () => clearTimeout(t);
    }
  }, [state.activeScenario, runScenarioAction]);

  const TABS: Array<{ key: TabKey; label: string; count: number }> = [
    { key: "all", label: "Tất cả", count: state.accounts.length },
    { key: "active", label: "Đang chạy", count: activeAccounts.length },
    { key: "suspended", label: "Tạm ngưng", count: suspendedAccounts.length },
  ];

  return (
    <>
      <div className="space-y-4">
        {/* Header */}
        <div className="flex items-center justify-between">
          <div>
            <h1 className="text-lg font-semibold text-foreground tracking-tight">Quản lý Tài khoản Ads (Sandbox)</h1>
            <p className="text-xs text-muted-foreground">
              {state.accounts.length} tài khoản trong môi trường giả lập
            </p>
          </div>
          <div className="flex items-center gap-2">
            <select
              className="text-sm border rounded-md p-1 bg-background"
              onChange={(e) => dispatch({ type: "LOAD_SCENARIO", scenario: e.target.value as any })}
              value={state.activeScenario || ""}
            >
              <option value="">-- Chọn Scenario Mẫu --</option>
              <option value="auto_suspend">Giả lập: Bị đình chỉ tài khoản</option>
              <option value="budget_exhausted">Giả lập: Hết ngân sách</option>
              <option value="deposit_success">Giả lập: Nạp tiền thành công</option>
              <option value="error_api_rate_limit">Giả lập: Lỗi Rate Limit API</option>
            </select>
          </div>
        </div>

        {/* Scenario hint */}
        {state.activeScenario && (
          <motion.div
            initial={{ opacity: 0, y: -4 }}
            animate={{ opacity: 1, y: 0 }}
            className="flex items-center gap-2 rounded-lg border border-primary/20 bg-primary/5 px-3 py-2 text-xs text-foreground/80"
          >
            {state.activeScenario.startsWith("error") ? (
              <AlertTriangle className="size-3.5 shrink-0 text-amber-400" />
            ) : (
              <Activity className="size-3.5 shrink-0 text-primary" />
            )}
            <span>
              Scenario: <span className="font-medium">{state.activeScenario.replace(/_/g, " ")}</span>
            </span>
            <Button variant="ghost" size="sm" className="ml-auto h-6 px-2 text-[10px]"
              onClick={runScenarioAction}
            >
              Chạy lại
            </Button>
          </motion.div>
        )}

        {/* Sync animation */}
        {isSyncingScenario && <SyncAnimation isActive currentStep={scenarioSyncStep} />}

        {/* Tabs */}
        <div className="flex items-center gap-1 border-b border-border/30">
          {TABS.map((t) => (
            <button
              key={t.key}
              onClick={() => setTab(t.key)}
              className={`relative px-3 pb-2.5 pt-1 text-sm font-medium transition-colors ${
                tab === t.key ? "text-foreground" : "text-muted-foreground hover:text-foreground/70"
              }`}
            >
              {t.label}
              <span className={`ml-1 inline-flex items-center justify-center rounded-full px-1.5 py-px text-[10px] font-semibold leading-none ${
                tab === t.key
                  ? "bg-primary/15 text-primary"
                  : "bg-muted/40 text-muted-foreground/60"
              }`}>{t.count}</span>
              {tab === t.key && (
                <motion.div
                  layoutId="ads-tab-indicator"
                  className="absolute bottom-0 left-1 right-1 h-[2px] rounded-full bg-primary"
                  transition={{ type: "spring", stiffness: 350, damping: 30 }}
                />
              )}
            </button>
          ))}
        </div>

        {/* Table */}
        <DataTable<AdsAccountItem>
          data={filteredAccounts}
          columns={columns}
          initialPageSize={20}
          emptyMessage="Không có tài khoản nào"
          getRowId={(row) => row.id}
          compact
          selectedRowIds={selectedIds.length > 0 ? selectedIds : undefined}
        />
      </div>
    </>
  );
}

/* ═══════════════════════════════════════════════
   MAIN EXPORT
   ═══════════════════════════════════════════════ */

export function AdsListPanel() {
  const [viewState, setViewState] = useState<ViewState>({ view: "list" });

  return (
    <AnimatePresence mode="wait">
      {viewState.view === "list" ? (
        <motion.div key="list" initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0, x: -20 }}>
          <AdsListView
            onViewDetail={(id) => setViewState({ view: "detail", accountId: id })}
          />
        </motion.div>
      ) : (
        <motion.div key="detail" initial={{ opacity: 0, x: 20 }} animate={{ opacity: 1, x: 0 }} exit={{ opacity: 0 }}>
          <AdsDetailView
            accountId={viewState.accountId}
            onBack={() => setViewState({ view: "list" })}
          />
        </motion.div>
      )}
    </AnimatePresence>
  );
}
