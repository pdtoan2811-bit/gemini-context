```diff:ads-sandbox-types.ts
===
import type { AdsAccountItem } from "./ads";
import type { AdsCampaign } from "./project-campaign-types";

export type AdsScenarioId =
  | "auto_suspend"
  | "budget_exhausted"
  | "deposit_success"
  | "link_new_campaign"
  | "error_api_rate_limit"
  | null;

export interface AdsEvent {
  id: string;
  type:
    | "account_suspended"
    | "budget_exhausted"
    | "deposit_success"
    | "campaign_linked"
    | "status_changed"
    | "api_rate_limit"
    | "info";
  timestamp: string;
  message: string;
  accountId?: string;
  campaignId?: string;
}

export interface AdsSandboxState {
  accounts: AdsAccountItem[];
  campaigns: AdsCampaign[]; // We will borrow campaigns from project-campaign-types to show linkages
  events: AdsEvent[];
  activeScenario: AdsScenarioId;
  isSyncing: boolean;
  syncStep: number | null;
}

export type AdsSandboxAction =
  | { type: "RESET" }
  | { type: "LOAD_SCENARIO"; scenario: AdsScenarioId }
  | { type: "SET_SYNCING"; isSyncing: boolean; syncStep?: number }
  | { type: "ADD_EVENT"; event: AdsEvent }
  | { type: "CHANGE_ACCOUNT_STATUS"; accountId: string; status: string }
  | { type: "DEPOSIT_BUDGET"; accountId: string; amount: number }
  | { type: "EXHAUST_BUDGET"; accountId: string }
  | { type: "LINK_CAMPAIGN"; accountId: string; campaign: AdsCampaign }
  | { type: "EDIT_ACCOUNT"; accountId: string; updates: Partial<AdsAccountItem> };
```
