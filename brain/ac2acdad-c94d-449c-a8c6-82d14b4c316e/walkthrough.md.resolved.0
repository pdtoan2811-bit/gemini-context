```diff:AdsDetailView.tsx
===
"use client";

import React from "react";
import { motion } from "framer-motion";
import { useAdsSandboxStore } from "@/hooks/useAdsSandboxStore";
import { Button } from "@/components/ui/button";
import { ArrowLeft, Wallet, TrendingUp, AlertTriangle } from "lucide-react";
import { formatNumber } from "@/lib/utils";
import { BadgeStatus } from "@/components/shared/badge-status";
import { Progress } from "@/components/ui/progress";

interface AdsDetailViewProps {
  accountId: string;
  onBack: () => void;
}

export function AdsDetailView({ accountId, onBack }: AdsDetailViewProps) {
  const { getAccount, getEventsForAccount } = useAdsSandboxStore();
  const account = getAccount(accountId);
  const events = getEventsForAccount(accountId);

  if (!account) {
    return (
      <div className="p-6 text-center text-muted-foreground">
        Không tìm thấy tài khoản.
        <Button variant="link" onClick={onBack} className="block mx-auto mt-4">
          Quay lại
        </Button>
      </div>
    );
  }

  const budgetPaid = account.budget_paid ?? 0;
  const budgetUsed = account.budget_used ?? 0;
  const budgetRemaining = account.budget_remaining ?? 0;
  const spendPercentage = budgetPaid > 0 ? (budgetUsed / budgetPaid) * 100 : 0;

  const statusRaw = account.ads_status || account.status_ads || "unknown";

  return (
    <div className="space-y-6">
      <div className="flex items-center gap-3 border-b border-border/30 pb-4">
        <Button variant="ghost" size="icon" onClick={onBack} className="h-8 w-8">
          <ArrowLeft className="h-4 w-4" />
        </Button>
        <div>
          <h2 className="text-xl font-semibold flex items-center gap-2">
            {account.ads_name || account.name_ads}
            <BadgeStatus type={statusRaw === "active" || statusRaw === "enabled" ? "completed" : statusRaw === "suspended" ? "failed" : "neutral"}>
              {statusRaw}
            </BadgeStatus>
          </h2>
          <p className="text-xs text-muted-foreground font-mono">Ads ID: {account.ads_id}</p>
        </div>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div className="rounded-xl border border-border/50 bg-card p-5 shadow-sm">
          <div className="flex items-center gap-2 text-muted-foreground mb-2">
            <Wallet className="h-4 w-4" />
            <span className="text-sm font-medium">Ngân sách đã nạp</span>
          </div>
          <div className="text-2xl font-bold">${formatNumber(budgetPaid, { decimals: 2 })}</div>
        </div>
        <div className="rounded-xl border border-border/50 bg-card p-5 shadow-sm">
          <div className="flex items-center gap-2 text-amber-500 mb-2">
            <TrendingUp className="h-4 w-4" />
            <span className="text-sm font-medium">Ngân sách đã tiêu</span>
          </div>
          <div className="text-2xl font-bold text-amber-500">${formatNumber(budgetUsed, { decimals: 2 })}</div>
        </div>
        <div className="rounded-xl border border-border/50 bg-card p-5 shadow-sm">
          <div className="flex items-center gap-2 text-primary mb-2">
            <AlertTriangle className="h-4 w-4" />
            <span className="text-sm font-medium">Ngân sách còn lại</span>
          </div>
          <div className="text-2xl font-bold text-primary">${formatNumber(budgetRemaining, { decimals: 2 })}</div>
        </div>
      </div>

      <div className="rounded-xl border border-border/50 bg-card p-5 shadow-sm">
        <h3 className="text-sm font-medium mb-4">Tiến độ chi tiêu</h3>
        <Progress value={spendPercentage} className="h-2 mb-2" />
        <div className="flex justify-between text-xs text-muted-foreground">
          <span>0%</span>
          <span>{spendPercentage.toFixed(1)}%</span>
          <span>100%</span>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div className="rounded-xl border border-border/50 bg-card shadow-sm flex flex-col">
          <div className="border-b border-border/30 px-5 py-4">
            <h3 className="font-medium">Chiến dịch đang chạy ({Array.isArray(account.campaigns) ? account.campaigns.length : 0})</h3>
          </div>
          <div className="p-5 flex-1 overflow-auto max-h-[400px]">
            {Array.isArray(account.campaigns) && account.campaigns.length > 0 ? (
              <div className="space-y-3">
                {account.campaigns.map((camp: any, idx) => (
                  <div key={idx} className="p-3 rounded-lg border border-border/50 bg-muted/20">
                    <div className="font-medium text-sm">{camp.name}</div>
                    <div className="text-xs text-muted-foreground mt-1">Status: {camp.status}</div>
                    <div className="text-xs text-muted-foreground font-mono truncate">{camp.finalUrl}</div>
                  </div>
                ))}
              </div>
            ) : (
              <div className="text-center text-muted-foreground text-sm py-10">Không có chiến dịch nào</div>
            )}
          </div>
        </div>

        <div className="rounded-xl border border-border/50 bg-card shadow-sm flex flex-col">
          <div className="border-b border-border/30 px-5 py-4">
            <h3 className="font-medium">Lịch sử sự kiện (Sandbox)</h3>
          </div>
          <div className="p-5 flex-1 overflow-auto max-h-[400px]">
            {events.length > 0 ? (
              <div className="space-y-4">
                {events.map((evt) => (
                  <motion.div initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }} key={evt.id} className="relative pl-6">
                    <div className="absolute left-1.5 top-1.5 h-2 w-2 rounded-full bg-primary/40 ring-4 ring-primary/10" />
                    <div className="absolute left-2 top-4 bottom-[-16px] w-px bg-border/50 last:hidden" />
                    <div className="text-xs text-muted-foreground mb-0.5">
                      {new Date(evt.timestamp).toLocaleString("vi-VN")}
                    </div>
                    <div className="text-sm font-medium">{evt.message}</div>
                    <div className="text-xs text-primary/70 font-mono mt-0.5">Type: {evt.type}</div>
                  </motion.div>
                ))}
              </div>
            ) : (
              <div className="text-center text-muted-foreground text-sm py-10">Chưa có sự kiện nào</div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}
